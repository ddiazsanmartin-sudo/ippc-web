---
/** Cabecera de páginas interiores: foto a sangre con velo azul y título serif. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { marca } from '@/lib/maqueta';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
  alt?: string;
  /** Punto focal de la foto (CSS object-position). */
  position?: 'center' | 'top' | 'bottom';
  /** MAQUETA: título o bajada redactados por el desarrollador (ver src/lib/maqueta.ts). */
  titleInventado?: boolean;
  leadInventado?: boolean;
}
const { eyebrow, title, lead, image, alt = '', position = 'center', titleInventado = false, leadInventado = false } = Astro.props;
---

<section class="page-header on-dark">
  <Image
    src={image}
    alt={alt}
    layout="full-width"
    class:list={['page-header__bg', `pos-${position}`]}
    loading="eager"
    fetchpriority="high"
  />
  <div class="container page-header__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class={marca(titleInventado)}>{title}</h1>
    {lead && <p class:list={['page-header__lead', marca(leadInventado)]}>{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(20rem, 42vh, 30rem);
    padding-block: clamp(3rem, 6vw, 5rem);
    color: var(--white);
    overflow: hidden;
  }
  .page-header :global(.page-header__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-header :global(.pos-top) {
    object-position: center 25%;
  }
  .page-header :global(.pos-bottom) {
    object-position: center 75%;
  }
  .page-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(14 21 48 / 0.9) 0%, rgb(14 21 48 / 0.7) 45%, rgb(14 21 48 / 0.35) 100%),
      linear-gradient(0deg, rgb(14 21 48 / 0.55), transparent 50%);
  }
  .page-header h1 {
    color: var(--white);
    max-width: 18ch;
    margin-bottom: 0.35em;
  }
  .page-header__lead {
    max-width: 52ch;
    font-size: var(--step-1);
    color: rgb(255 255 255 / 0.86);
    margin: 0;
  }
</style>
