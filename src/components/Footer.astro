---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import logoBlanco from '@/assets/marca/logo-blanco.png';
import { footerNav } from '@/lib/navigation';
import Icon, { type IconName } from './Icon.astro';
import { inventado, marca } from '@/lib/maqueta';
import Inventado from './Inventado.astro';

interface Props {
  sitio: CollectionEntry<'sitio'>['data'];
}
const { sitio } = Astro.props;

const redes = (
  [
    ['youtube', 'YouTube', sitio.redes.youtube],
    ['instagram', 'Instagram', sitio.redes.instagram],
    ['facebook', 'Facebook', sitio.redes.facebook],
  ] as [IconName, string, string | undefined][]
).filter(([, , url]) => !!url);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Image src={logoBlanco} alt="" width={88} height={88} class="site-footer__logo" />
      <p class="site-footer__name">{sitio.nombre}</p>
      <p class="site-footer__motto">«{sitio.lema}»</p>
      <p class="site-footer__denom">
        Miembro de la {sitio.denominacion.nombre} ({sitio.denominacion.sigla})
      </p>
    </div>

    <div>
      <h2 class="site-footer__title">Horarios</h2>
      <ul class="site-footer__list" role="list">
        {sitio.horarios.map((h) => (
          <li>
            <strong>{h.nombre}</strong>
            <span>
              {h.dia} · {h.hora} hrs
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">Encuéntranos</h2>
      <address class="site-footer__list">
        <p class="site-footer__line">
          <Icon name="mapPin" size={18} />
          <span>
            {sitio.direccion.calle}, {sitio.direccion.comuna}
            <br />
            {sitio.direccion.ciudad}, Chile
          </span>
        </p>
        <p class="site-footer__line">
          <Icon name="mail" size={18} />
          <a href={`mailto:${sitio.contacto.email}`}>{sitio.contacto.email}</a>
        </p>
        {sitio.contacto.telefono && (
          <p class="site-footer__line">
            <Icon name="phone" size={18} />
            <a href={`tel:${sitio.contacto.telefono.replace(/\s/g, '')}`}>{sitio.contacto.telefono}</a>
          </p>
        )}
      </address>
      {redes.length > 0 && (
        <ul class:list={['site-footer__social', marca(inventado.redes)]} role="list">
          {redes.map(([icon, label, url]) => (
            <li>
              <a href={url} rel="noopener noreferrer" target="_blank">
                <Icon name={icon} label={`${label} (se abre en una pestaña nueva)`} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-label="Pie de página">
      <h2 class="site-footer__title">Explora</h2>
      <ul class="site-footer__list site-footer__nav" role="list">
        {footerNav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>
      © {year} {sitio.nombre}. <Inventado>Soli Deo Gloria.</Inventado>
    </p>
    <p>
      <a href="/privacidad">Política de privacidad</a> · Sitio sin cookies de seguimiento
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-950);
    color: rgb(255 255 255 / 0.72);
    font-size: 0.95rem;
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
  }
  .site-footer a {
    color: rgb(255 255 255 / 0.86);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--gold-400);
    text-decoration: underline;
  }
  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
  }
  @media (max-width: 960px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
  .site-footer__logo {
    width: 76px;
    height: auto;
    margin-bottom: 1rem;
    opacity: 0.95;
  }
  .site-footer__name {
    font-family: var(--font-serif), serif;
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--white);
    margin-bottom: 0.4rem;
  }
  .site-footer__motto {
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--gold-400);
  }
  .site-footer__denom {
    font-size: 0.85rem;
  }
  .site-footer__title {
    font-family: var(--font-sans), sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin-bottom: 1.1rem;
  }
  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-style: normal;
    display: grid;
    gap: 0.75rem;
  }
  .site-footer__list li {
    display: grid;
  }
  .site-footer__list strong {
    color: var(--white);
    font-weight: 600;
  }
  .site-footer__line {
    display: flex;
    gap: 0.6rem;
    margin: 0;
  }
  .site-footer__line :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--blue-300);
  }
  .site-footer__nav {
    gap: 0.5rem;
  }
  .site-footer__social {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
  }
  .site-footer__social a:hover {
    border-color: var(--gold-400);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3.5rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.85rem;
  }
  .site-footer__bottom p {
    margin: 0;
  }
</style>
