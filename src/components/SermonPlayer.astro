---
/**
 * Reproductor "fachada" para YouTube, orientado a privacidad:
 * - Hasta que la persona presiona ▶, NO se hace ninguna petición a Google (ni cookies, ni miniaturas):
 *   la portada es una imagen local optimizada.
 * - Al presionar, se inserta un iframe de youtube-nocookie.com con `sandbox`.
 * - Sin JavaScript, el enlace abre el video en YouTube.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import poster from '@/assets/fotos/pulpito-santa-cena.jpg';
import { formatCalendarDate } from '@/lib/dates';
import { inventado, marca } from '@/lib/maqueta';
import Icon from './Icon.astro';

interface Props {
  sermon: CollectionEntry<'sermones'>;
}
const { sermon } = Astro.props;
const { titulo, youtube_id, pasaje } = sermon.data;
const watchUrl = `https://www.youtube.com/watch?v=${youtube_id}`;
---

<div class="player">
  <a class="player__facade" href={watchUrl} data-youtube-id={youtube_id} data-title={titulo} rel="noopener noreferrer" target="_blank">
    <Image src={poster} alt="" width={960} height={540} class="player__poster" />
    <span class="player__veil"></span>
    <span class="player__button">
      <Icon name="play" size={30} />
    </span>
    <span class:list={['player__caption', marca(inventado.sermones.has(sermon.id))]}>
      <span class="player__passage">{pasaje}</span>
      <span class="visually-hidden">Reproducir sermón: </span>
      <span class="player__title">{titulo}</span>
      <span class="player__date">{formatCalendarDate(sermon.data.fecha)}</span>
    </span>
  </a>
</div>

<script>
  const ID = /^[\w-]{11}$/;
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-youtube-id]')) {
    link.addEventListener('click', (event) => {
      const id = link.dataset.youtubeId ?? '';
      if (!ID.test(id)) return; // deja que el enlace funcione normalmente
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = link.dataset.title ?? 'Sermón';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-presentation allow-popups');
      iframe.allowFullscreen = true;
      iframe.className = 'player__iframe';
      link.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--navy-950);
    box-shadow: var(--shadow-md);
  }
  .player__facade {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--white);
    text-decoration: none;
  }
  .player__facade :global(.player__poster) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .player__facade:hover :global(.player__poster) {
    transform: scale(1.03);
  }
  .player__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(14 21 48 / 0.88) 0%, rgb(14 21 48 / 0.25) 55%, rgb(14 21 48 / 0.1));
  }
  .player__button {
    position: absolute;
    left: 50%;
    top: 42%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--gold-400);
    color: var(--navy-950);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.3);
    transition: transform 0.25s var(--ease);
  }
  .player__button :global(svg) {
    margin-left: 4px;
  }
  .player__facade:hover .player__button,
  .player__facade:focus-visible .player__button {
    transform: scale(1.08);
  }
  .player__caption {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.15rem;
    padding: clamp(1rem, 3vw, 1.75rem);
  }
  .player__passage {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-400);
  }
  .player__title {
    font-family: var(--font-serif), serif;
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .player__date {
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .player :global(.player__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
