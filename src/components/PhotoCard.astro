---
/** Tarjeta grande con foto, al estilo de las secciones "Creencias / Comunidad" de veniracristo.org. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  href: string;
  image: ImageMetadata;
  alt: string;
  title: string;
  text: string;
  cta?: string;
}
const { href, image, alt, title, text, cta = 'Conoce más' } = Astro.props;
---

<article class="photo-card">
  <div class="photo-card__media">
    <Image src={image} alt={alt} width={640} height={440} class="photo-card__img" />
  </div>
  <div class="photo-card__body">
    <h3>
      <a href={href} class="photo-card__link">
        {title}
      </a>
    </h3>
    <p>{text}</p>
    <span class="link-arrow" aria-hidden="true">
      {cta} <Icon name="arrowRight" />
    </span>
  </div>
</article>

<style>
  .photo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .photo-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }
  .photo-card__media {
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }
  .photo-card :global(.photo-card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .photo-card:hover :global(.photo-card__img) {
    transform: scale(1.04);
  }
  .photo-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem 1.6rem 1.7rem;
  }
  .photo-card h3 {
    font-size: var(--step-2);
    margin-bottom: 0.4rem;
  }
  .photo-card__link {
    color: inherit;
    text-decoration: none;
  }
  /* Toda la tarjeta es clicable sin anidar enlaces (patrón "stretched link"). */
  .photo-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .photo-card__link:focus-visible {
    outline: none;
  }
  .photo-card:has(.photo-card__link:focus-visible) {
    outline: 3px solid var(--gold-500);
    outline-offset: 3px;
  }
  .photo-card p {
    font-size: 0.97rem;
    color: var(--ink-500);
  }
  .photo-card .link-arrow {
    margin-top: auto;
    color: var(--blue-700);
  }
</style>
