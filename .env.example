# Copiar a `.env` para desarrollo local. NUNCA versionar `.env`.
# En producción estos valores se cargan como secretos de Cloudflare (`wrangler secret put`).

# Cloudflare Turnstile (anti-bots). Las claves de abajo son las CLAVES DE PRUEBA oficiales
# de Cloudflare: siempre aprueban. Reemplazar por las reales en producción.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Destino de los mensajes del formulario de contacto.
CONTACT_TO_EMAIL=ip.pactodecristo@gmail.com
CONTACT_FROM_EMAIL="Sitio web IPPC <no-responder@pactodecristo.cl>"

# Entrega de mensajes: `log` (desarrollo: se registran en consola SIN datos personales)
# o `resend` (producción: valor por defecto si no se define).
CONTACT_DELIVERY=log

# Proveedor de correo (solo necesario con CONTACT_DELIVERY=resend).
RESEND_API_KEY=
